# Public browser-safe Supabase values. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only database connection URL for PostgreSQL migrations and scripts
DATABASE_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-1-your-region.pooler.supabase.com:5432/postgres
CAMPUS_DATABASE_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-1-your-region.pooler.supabase.com:5432/postgres

# Server-only values for trusted jobs/admin workflows; keep unset locally until needed.
SUPABASE_SERVICE_ROLE_KEY=
